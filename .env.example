# Required. From console.groq.com. Server only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Groq chat model that writes the answers. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Required. Upstash Vector index (created with an Upstash embedding model).
# Added by Vercel when the index is connected from the Storage page.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Blob store credentials. Vercel adds these when a Blob store is connected:
# newer projects get BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (with automatic OIDC auth),
# older ones get BLOB_READ_WRITE_TOKEN. For local testing, set BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional. "private" (default) or "public". Must match the access setting of your Blob store.
NEXT_PUBLIC_BLOB_ACCESS=

# Optional. Shown in the sidebar. Defaults to "Document Q&A".
NEXT_PUBLIC_APP_NAME=
