# Required. From Google AI Studio. Server only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Chat model; must support File Search. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Optional. Leave empty and the app finds or creates a store named "document-qa-app".
# Set it only to pin a specific store, e.g. fileSearchStores/abc123.
GEMINI_FILE_SEARCH_STORE=

# Added automatically by Vercel when a Blob store is connected. Copy it here for local testing.
BLOB_READ_WRITE_TOKEN=

# Optional. "private" (default) or "public". Must match the access setting of your Blob store.
NEXT_PUBLIC_BLOB_ACCESS=

# Optional. Shown in the sidebar. Defaults to "Document Q&A".
NEXT_PUBLIC_APP_NAME=
